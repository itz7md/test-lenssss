# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_ADMIN_EMAILS: Comma-separated list of admin email addresses.
# Users logging in with any of these emails will automatically receive store admin privileges.
NEXT_PUBLIC_ADMIN_EMAILS="eng8137@gmail.com"

# Tap Payments Gateway Configuration (Production or Test keys)
# TAP_SECRET_KEY: Secret key from Tap Payments Dashboard (e.g., sk_live_... or sk_test_...)
TAP_SECRET_KEY="sk_test_XKokBfNWv6FIYuTMg5sLPjhJ"

# NEXT_PUBLIC_TAP_PUBLIC_KEY: Public key for client-side card/Apple Pay SDK (e.g., pk_live_... or pk_test_...)
NEXT_PUBLIC_TAP_PUBLIC_KEY="pk_test_Vlk842B1EA7tDN5QbrfGjYzh"

# NEXT_PUBLIC_TAP_MERCHANT_ID: Your Tap Payments Merchant ID
NEXT_PUBLIC_TAP_MERCHANT_ID=""

# Google Maps Platform Configuration
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY: Google Maps API Key used for automatic address detection & Reverse Geocoding.
# Add this variable in your Firebase Console / App Hosting configuration to enable automated checkout address detection.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# OTO Logistics Configuration
# OTO_API_TOKEN: Bearer / Access Token provided by OTO Logistics for API REST Integration.
# Add this variable in your Firebase Console / App Hosting configuration to enable server-side automated fulfillment.
OTO_API_TOKEN=""

